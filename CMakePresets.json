{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "APP_WARNINGS_AS_ERRORS": "ON",
        "APP_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux (Ninja, analysis on)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "APP_WARNINGS_AS_ERRORS": "ON",
        "APP_ENABLE_CLANG_TIDY": "OFF",
        "APP_ENABLE_CPPCHECK": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "ci-linux", "configurePreset": "ci-linux" }
  ],
  "testPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "ci-linux", "configurePreset": "ci-linux", "output": { "outputOnFailure": true } }
  ]
}
